# Use uma chave estática ou as duas credenciais OAuth. Nunca exponha estes valores no frontend.
SENDPULSE_API_KEY=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=

# ID numérico da lista que receberá os contatos do formulário.
SENDPULSE_ADDRESSBOOK_ID=

# Consulta segura dos dados já coletados pelo Vercel Web Analytics.
VERCEL_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Microsoft Clarity: o ID público habilita gravações após consentimento.
VITE_CLARITY_PROJECT_ID=
CLARITY_PROJECT_ID=
