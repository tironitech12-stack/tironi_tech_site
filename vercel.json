{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en/blog/archive", "destination": "/blog", "permanent": true },
    { "source": "/es/blog/archive", "destination": "/blog", "permanent": true },
    { "source": "/en/blog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/es/blog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/en/blog", "destination": "/blog", "permanent": true },
    { "source": "/es/blog", "destination": "/blog", "permanent": true }
  ],
  "headers": [
    {
      "source": "/painel",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    }
  ]
}
